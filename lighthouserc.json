{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "url": ["http://localhost/"],
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
